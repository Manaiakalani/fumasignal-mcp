{
  "name": "fumasignal-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets AI assistants search and read any Fumadocs documentation site.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fumadocs",
    "documentation",
    "ai",
    "claude",
    "cursor",
    "llm"
  ],
  "homepage": "https://github.com/Manaiakalani/fumasignal-mcp#readme",
  "bugs": "https://github.com/Manaiakalani/fumasignal-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manaiakalani/fumasignal-mcp.git"
  },
  "license": "MIT",
  "author": "Manaiakalani",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "fumasignal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepublishOnly": "npm run build",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "changeset-version": "changeset version && npm install --package-lock-only",
    "changeset-publish": "node scripts/changeset-publish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "gray-matter": "^4.0.3",
    "pino": "^10.4.0",
    "turndown": "^7.2.5",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.16.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.4",
    "postcss": "^8.5.25",
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "gray-matter": {
      "js-yaml": "^3.15.1"
    },
    "js-yaml": "4.3.2",
    "undici": "8.12.4",
    "zod": "4.6.7",
    "body-parser": "2.4.0",
    "qs": "6.17.1",
    "@hono/node-server": "2.1.8"
  }
}
